# Veil Logging Configuration
# Copy this file to .env and modify as needed

# Loki endpoint (where to send logs)
LOKI_URL=http://localhost:3100

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Additional labels for logs (JSON format)
LOG_LABELS={"environment":"development","service":"veil-gateway","version":"v1.0.0"}

# Grafana configuration
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

# Log retention (in days)
LOG_RETENTION_DAYS=30

# Enable/disable log shipping to Loki (true/false)
ENABLE_LOKI_SHIPPING=true

# Batch size for log shipping
LOKI_BATCH_SIZE=1048576

# Timeout for Loki requests (in seconds)
LOKI_TIMEOUT=10